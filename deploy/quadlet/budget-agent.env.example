APP_ADDR=127.0.0.1:8080
DATABASE_PATH=/data/budget.db
RECEIPTS_DIR=/data/receipts
BASE_URL=https://budget-agent.tailnet.ts.net
AUTH_MODE=tailnet
TOKEN_PEPPER=replace-with-a-long-random-string
LOG_LEVEL=info
DEFAULT_CURRENCY=IDR
TZ=UTC

# Optional AI (leave AI_ENABLED=false to disable)
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
AI_TIMEOUT=30s

# Optional WhatsApp (deferred; leave disabled for v1)
WHATSAPP_ENABLED=false
